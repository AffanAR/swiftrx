{
  "name": "swiftrx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev:portal": "npm run dev -w @swiftrx/doctor-portal",
    "dev:admin": "npm run dev -w @swiftrx/admin",
    "dev:all": "node scripts/dev.mjs all",
    "dev:gateway": "node scripts/dev.mjs gateway",
    "dev:api": "npm run dev -w @swiftrx/api",
    "build:portal": "npm run build -w @swiftrx/doctor-portal",
    "build:admin": "npm run build -w @swiftrx/admin",
    "build": "npm run build:portal && npm run build:admin",
    "start": "node scripts/serve.mjs",
    "preview:portal": "npm run preview -w @swiftrx/doctor-portal",
    "preview:admin": "npm run preview -w @swiftrx/admin",
    "db:setup": "npm run db:setup -w @swiftrx/api --",
    "db:up": "docker compose up -d --wait && npm run db:setup -w @swiftrx/api -- --url postgres://swiftrx:swiftrx@localhost:5432/swiftrx",
    "db:migrate": "npm run db:migrate -w @swiftrx/api --",
    "db:seed": "npm run db:seed -w @swiftrx/api --",
    "db:reset": "npm run db:reset -w @swiftrx/api --",
    "db:generate": "npm run db:generate -w @swiftrx/api",
    "typecheck": "tsc -p apps/doctor-portal/tsconfig.json --noEmit && tsc -p apps/admin/tsconfig.json --noEmit && tsc -p apps/api/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20.12.0",
    "@vitest/coverage-v8": "^2.1.9",
    "bcryptjs": "^3.0.3",
    "concurrently": "^9.2.4",
    "drizzle-orm": "^0.45.4",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "http-proxy-middleware": "^2.0.6",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.9.10",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.9"
  },
  "overrides": {
    "eslint-plugin-jsx-a11y": {
      "eslint": "$eslint"
    }
  }
}
