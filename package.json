{
  "name": "swiftrx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:portal": "npm run dev -w @swiftrx/doctor-portal",
    "dev:admin": "npm run dev -w @swiftrx/admin",
    "dev:all": "node scripts/dev.mjs all",
    "dev:gateway": "node scripts/dev.mjs gateway",
    "build:portal": "npm run build -w @swiftrx/doctor-portal",
    "build:admin": "npm run build -w @swiftrx/admin",
    "build": "npm run build:portal && npm run build:admin",
    "start": "node scripts/serve.mjs",
    "preview:portal": "npm run preview -w @swiftrx/doctor-portal",
    "preview:admin": "npm run preview -w @swiftrx/admin"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "concurrently": "^9.2.4",
    "http-proxy-middleware": "^2.0.6"
  }
}
