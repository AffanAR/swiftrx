{
  "name": "swiftrx",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:rx": "vite",
    "dev:portal": "npm run dev -w @swiftrx/doctor-portal",
    "dev:admin": "npm run dev -w @swiftrx/admin",
    "dev:all": "node scripts/dev.mjs all",
    "dev:gateway": "node scripts/dev.mjs gateway",
    "build:rx": "tsc -b && vite build",
    "build:portal": "npm run build -w @swiftrx/doctor-portal",
    "build:admin": "npm run build -w @swiftrx/admin",
    "build": "npm run build:rx && npm run build:portal && npm run build:admin",
    "preview:rx": "vite preview",
    "preview:portal": "npm run preview -w @swiftrx/doctor-portal",
    "preview:admin": "npm run preview -w @swiftrx/admin"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.26.2"
  },
  "devDependencies": {
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^9.2.4",
    "http-proxy-middleware": "^2.0.6",
    "postcss": "^8.4.39",
    "tailwindcss": "^3.4.6",
    "typescript": "^5.5.3",
    "vite": "^5.3.4"
  }
}
