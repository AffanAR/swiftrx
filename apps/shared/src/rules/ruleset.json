  "pregnancy": {
    "g593": {
      "level": "avoid",
      "note": "NSAIDs: avoid in pregnancy, and don't use from 20 weeks unless essential (kidney and heart effects on the baby)."
    },
    "g691": {
      "level": "contraindicated",
      "note": "ACE inhibitors harm the baby's kidneys and skull in the second and third trimesters."
    },
    "g92": { "level": "contraindicated", "note": "Statins: stop before and during pregnancy." },
    "g62": {
      "level": "caution",
      "note": "Limited data; use only if no safer option controls the blood pressure."
    },
    "g918": {
      "level": "caution",
      "note": "Use the lowest effective dose; long courses need monitoring."
    },
    "g827": {
      "level": "caution",
      "note": "Avoid in the first trimester unless other anti-sickness treatment has failed."
    },
    "g734": {
      "level": "caution",
      "note": "Usually switched to insulin in pregnancy; specialist decision."
    }
  },

