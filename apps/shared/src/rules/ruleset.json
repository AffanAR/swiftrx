    },
    {
      "between": ["aspirin", "ibuprofen"],
      "severity": "moderate",
      "note": "Ibuprofen can blunt aspirin's antiplatelet effect, and both irritate the stomach."
    },
    {
      "between": ["lisinopril", "ibuprofen"],
      "severity": "moderate",
      "note": "NSAIDs reduce the blood-pressure effect and, with ACE inhibitors, can harm the kidneys."
    },
    {
      "between": ["methotrexate", "amoxicillin"],
      "severity": "moderate",
      "note": "Penicillins can raise methotrexate levels."
    },
    {
      "between": ["prednisolone", "ibuprofen"],
      "severity": "moderate",
      "note": "Steroids with NSAIDs raise the risk of stomach bleeding."
    },
    {
      "between": ["prednisolone", "aspirin"],
      "severity": "moderate",
      "note": "Steroids with aspirin raise the risk of stomach bleeding."
