# Copy to apps/api/.env (gitignored) to change where the API keeps its data.
# Variables already set in your shell win over this file.

# Postgres, e.g. the Docker database from compose.yaml (`npm run db:up`).
# Leave unset to use PGlite (Postgres in WebAssembly, nothing to install).
# DATABASE_URL=postgres://swiftrx:swiftrx@localhost:5432/swiftrx

# Where PGlite keeps its files when DATABASE_URL is unset. Default: apps/api/.pglite
# PGLITE_DIR=

# Where the API listens. Default: 127.0.0.1:5176
# API_HOST=127.0.0.1
# API_PORT=5176

# Demo mode: the sign-in pages list the demo accounts' passwords (from
# GET /api/auth/demo-accounts). On unless VITE_DEMO_MODE=false, the same
# switch that turns off the apps' demo banner.
# VITE_DEMO_MODE=false

# Session cookies are Secure whenever a request came over HTTPS; production
# makes them Secure always.
# NODE_ENV=production
